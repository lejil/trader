# Copy to .env and fill in. .env is gitignored.
ANTHROPIC_API_KEY=

# Optional overrides
# CLAUDE_MODEL=claude-haiku-5-5            # research agents (TradingView + web search)
# CLAUDE_DECISION_MODEL=claude-sonnet-5-5  # decision / orchestrator
# PROMPTS_DIR=prompts   # folder with the prompt .md files (see prompts/README.md)
# LOG_LEVEL=INFO   # DEBUG | INFO | WARNING | ERROR; logs go to the console and logs/trader.log

# TradingView needs no key here. Sign in once with: python -m app.tradingview_auth
# (tokens are stored in .tokens/tradingview.json and refreshed automatically)
